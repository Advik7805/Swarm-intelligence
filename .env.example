# ── LLM (OpenAI-compatible). Leave blank to run in fully-offline DEMO MODE.
# Examples:
#   OpenAI:    LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL_NAME=gpt-4o-mini
#   Qwen:      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL_NAME=qwen-plus
#   Groq:      LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL_NAME=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=

# ── Local Ollama (optional; takes precedence over blank key)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# ── Backend
PORT=8000
DATABASE_URL=sqlite:///data/hivemind.db

# ── Demo mode (auto = demo when no LLM key). Set "false" to force live.
DEMO_MODE=auto

# ── Frontend (optional; defaults to same-origin /api proxy)
# NEXT_PUBLIC_API_BASE=
# NEXT_PUBLIC_WS_URL=
