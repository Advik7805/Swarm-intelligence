# ============================================================
# HiveMind - Environment Configuration
# Copy this file to `.env` and fill in your keys.
# ============================================================

# ---------- LLM API (required) ----------
# Any OpenAI SDK-compatible API works. Default: Google Gemini
# Get a FREE key at: https://aistudio.google.com/apikey
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_NAME=gemini-2.0-flash

# ---------- Zep Cloud (required) ----------
# Agent memory graph. Free monthly quota is enough to start.
# Get a FREE key at: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ---------- Boost LLM (optional) ----------
# A second, faster model to accelerate simulation steps.
# Leave these OUT of your .env entirely if not using.
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
